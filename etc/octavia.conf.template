
[DEFAULT]
graceful_shutdown_timeout = 300
transport_url = rabbit://stackrabbit:${RABBIT_PASSWORD}@${CONTROLLER_HOST}:5672/
debug = True
log_color = True
logging_exception_prefix = ERROR %(name)s [01;35m%(instance)s[00m
logging_default_format_string = %(color)s%(levelname)s %(name)s [[00;36m-%(color)s] [01;35m%(instance)s%(color)s%(message)s[00m
logging_context_format_string = %(color)s%(levelname)s %(name)s [[01;36m%(global_request_id)s %(request_id)s [00;36m%(project_name)s %(user_name)s%(color)s] [01;35m%(instance)s%(color)s%(message)s[00m
logging_debug_format_suffix = [00;33m{{(pid=%(process)d) %(funcName)s %(pathname)s:%(lineno)d}}[00m

[api_settings]
enabled_provider_drivers = amphora:The Octavia Amphora driver.,octavia:Deprecated alias of the Octavia Amphora driver.,ovn:Octavia OVN driver.
api_handler = queue_producer
bind_host = ${CONTROLLER_HOST}

[database]
connection = mysql+pymysql://root:${DB_PASSWORD}@127.0.0.1:3306/octavia

[task_flow]
jobboard_enabled = False

[keystone_authtoken]
memcached_servers = localhost:11211
cafile = ${CAFILE}
www_authenticate_uri = http://${CONTROLLER_HOST}/identity
project_domain_name = Default
project_name = service
user_domain_name = Default
password = ${OCTAVIA_PASSWORD}
username = octavia
auth_url = http://${CONTROLLER_HOST}/identity
interface = public
auth_type = password

[service_auth]
memcached_servers = ${CONTROLLER_HOST}:11211
cafile = ${CAFILE}
project_domain_name = Default
project_name = admin
user_domain_name = Default
password = ${ADMIN_PASSWORD}
username = admin
auth_type = password
auth_url = http://${CONTROLLER_HOST}/identity

[neutron]
cafile = ${CAFILE}
project_domain_name = Default
project_name = admin
user_domain_name = Default
password = ${ADMIN_PASSWORD}
username = admin
auth_type = password
auth_url = http://${CONTROLLER_HOST}/identity

[controller_worker]
amp_image_owner_id = ${AMP_IMAGE_OWNER_ID}
amp_secgroup_list = ${AMP_SECGROUP_LIST}
amp_flavor_id = ${AMP_FLAVOR_ID}
amp_boot_network_list = ${AMP_BOOT_NETWORK_LIST}
client_ca = /etc/octavia/certs/client_ca.cert.pem
amp_ssh_key_name = octavia_ssh_key
workers = 2
amp_active_wait_sec = 2
amp_active_retries = 30
loadbalancer_topology = ACTIVE_STANDBY
amp_timezone = Europe/Paris
amp_image_tag = amphora
image_driver = image_glance_driver
network_driver = allowed_address_pairs_driver
volume_driver = volume_noop_driver
compute_driver = compute_nova_driver
amphora_driver = amphora_haproxy_rest_driver

[health_manager]
bind_port = 5555
bind_ip = ${HM_IP}
controller_ip_port_list = ${HM_IP}:5555
heartbeat_key = insecure

[house_keeping]
load_balancer_expiry_age = 3600
amphora_expiry_age = 3600

[oslo_messaging]
topic = octavia_prov
rpc_thread_pool_size = 2

[haproxy_amphora]
server_ca = /etc/octavia/certs/server_ca-chain.cert.pem
client_cert = /etc/octavia/certs/private/client.cert-and-key.pem
rest_request_read_timeout = 30
rest_request_conn_timeout = 10
connection_retry_interval = 2
connection_max_retries = 30

[certificates]
server_certs_key_passphrase = insecure-key-do-not-use-this-key
ca_private_key_passphrase = not-secure-passphrase
ca_private_key = /etc/octavia/certs/private/server_ca.key.pem
ca_certificate = /etc/octavia/certs/server_ca.cert.pem

[driver_agent]
enabled_provider_agents = ovn

[ovn]
ovn_sb_connection = tcp:${CONTROLLER_HOST}:6642
ovn_nb_connection = tcp:${CONTROLLER_HOST}:6641

[amphora_agent]
administrative_log_facility = 1
user_log_facility = 0
tenant_log_targets = ${HM_IP}:20514
admin_log_targets = ${HM_IP}:10514
forward_all_logs = True
